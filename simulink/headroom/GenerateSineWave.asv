F0 = 5e6       % Desired output frequency (Hz)
Deltaf = 1/();  % Frequency resolution (Hz)
SFDR = 126;      % Spurious free dynamic range (dB)
Ts = 1/250e6;    % Sample period (s)
phOffd = pi/2;  % Desired phase offset (rad)
N = ceil(log2(1/(Ts*Deltaf)))
Q = ceil((SFDR - 12)/6)
phIncr = round(F0*2^N*Ts)
phOff = floor((2^N*phOffd)/(2*pi))
ditherBits = N - Q