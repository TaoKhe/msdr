# T12_DSP_v01.pdf, sheet 23 (5.6 BANK_66_67), XCZU15EG-2FFVB1156I.
# FPGA_SYSCLK is single-ended; the PDF does not route MCS or ZCU102 board GPIO.
set_property -dict {PACKAGE_PIN P10  IOSTANDARD LVCMOS18} [get_ports fpga_ref_clk]

set_property -dict {PACKAGE_PIN U10  IOSTANDARD LVCMOS18} [get_ports dgpio_0]
set_property -dict {PACKAGE_PIN AB8  IOSTANDARD LVCMOS18} [get_ports dgpio_1]
set_property -dict {PACKAGE_PIN Y10  IOSTANDARD LVCMOS18} [get_ports dgpio_2]
set_property -dict {PACKAGE_PIN AC9  IOSTANDARD LVCMOS18} [get_ports dgpio_3]
set_property -dict {PACKAGE_PIN AA11 IOSTANDARD LVCMOS18} [get_ports dgpio_4]
set_property -dict {PACKAGE_PIN Y12  IOSTANDARD LVCMOS18} [get_ports dgpio_5]
set_property -dict {PACKAGE_PIN AC8  IOSTANDARD LVCMOS18} [get_ports dgpio_6]
set_property -dict {PACKAGE_PIN AC7  IOSTANDARD LVCMOS18} [get_ports dgpio_7]
set_property -dict {PACKAGE_PIN AC6  IOSTANDARD LVCMOS18} [get_ports dgpio_8]
set_property -dict {PACKAGE_PIN AB6  IOSTANDARD LVCMOS18} [get_ports dgpio_9]
set_property -dict {PACKAGE_PIN AB1  IOSTANDARD LVCMOS18} [get_ports dgpio_10]
set_property -dict {PACKAGE_PIN AB5  IOSTANDARD LVCMOS18} [get_ports dgpio_11]

# MODE is the same ADRV9002 pin as DGPIO_11, not a second FPGA port.
set_property -dict {PACKAGE_PIN AC11 IOSTANDARD LVCMOS18} [get_ports gp_int]
set_property -dict {PACKAGE_PIN AA12 IOSTANDARD LVCMOS18} [get_ports reset_trx]

set_property -dict {PACKAGE_PIN AB11 IOSTANDARD LVCMOS18} [get_ports rx1_enable]
set_property -dict {PACKAGE_PIN T10  IOSTANDARD LVCMOS18} [get_ports rx2_enable]
set_property -dict {PACKAGE_PIN AA2  IOSTANDARD LVCMOS18} [get_ports tx1_enable]
set_property -dict {PACKAGE_PIN AA8  IOSTANDARD LVCMOS18} [get_ports tx2_enable]

set_property -dict {PACKAGE_PIN AA10 IOSTANDARD LVCMOS18} [get_ports spi_clk]
set_property -dict {PACKAGE_PIN Y9   IOSTANDARD LVCMOS18} [get_ports spi_dio]
set_property -dict {PACKAGE_PIN AB9  IOSTANDARD LVCMOS18} [get_ports spi_do]
set_property -dict {PACKAGE_PIN AB10 IOSTANDARD LVCMOS18} [get_ports spi_en]

create_clock -name spi0_clk -period 40 [get_pins -hier */EMIOSPI0SCLKO]
create_clock -name spi1_clk -period 40 [get_pins -hier */EMIOSPI1SCLKO]

# DCOSC SPI uses PS SPI1 EMIO; bank 66 is 1.8 V.
set_property -dict {PACKAGE_PIN AB4 IOSTANDARD LVCMOS18} [get_ports dcosc_sclk]
set_property -dict {PACKAGE_PIN V4  IOSTANDARD LVCMOS18} [get_ports dcosc_mosi]
set_property -dict {PACKAGE_PIN AC4 IOSTANDARD LVCMOS18} [get_ports dcosc_miso]
set_property -dict {PACKAGE_PIN V3  IOSTANDARD LVCMOS18} [get_ports dcosc_csn]

# T12 sheet 21, banks 44/47/48/50: all board controls are high-Z at AXI GPIO reset.
# Array bit 0 corresponds to net suffix 1 (SW arrays start at SW13).
set_property -dict {PACKAGE_PIN AG13 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {rfsw_ctrl[0]}]
set_property -dict {PACKAGE_PIN AL12 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {rfsw_ctrl[1]}]
set_property -dict {PACKAGE_PIN AN12 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {rfsw_ctrl[2]}]
set_property -dict {PACKAGE_PIN AJ15 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {rfsw_ctrl[3]}]
set_property -dict {PACKAGE_PIN AK13 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {lbf_ctrl[0]}]
set_property -dict {PACKAGE_PIN AP12 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {lbf_ctrl[1]}]
set_property -dict {PACKAGE_PIN AN14 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {lbf_ctrl[2]}]
set_property -dict {PACKAGE_PIN AL13 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {lbf_ctrl[3]}]
set_property -dict {PACKAGE_PIN AM14 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {lbf_ctrl[4]}]

# These additional FPGA pads are tied to the same RF nets on the PCB.
set_property -dict {PACKAGE_PIN H10 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {rfsw_ctrl_sense[0]}]
set_property -dict {PACKAGE_PIN E10 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {rfsw_ctrl_sense[1]}]
set_property -dict {PACKAGE_PIN F10 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {rfsw_ctrl_sense[2]}]
set_property -dict {PACKAGE_PIN D10 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {rfsw_ctrl_sense[3]}]
set_property -dict {PACKAGE_PIN D11 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {lbf_ctrl_sense[0]}]
set_property -dict {PACKAGE_PIN G11 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {lbf_ctrl_sense[1]}]
set_property -dict {PACKAGE_PIN H11 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {lbf_ctrl_sense[2]}]
set_property -dict {PACKAGE_PIN F11 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {lbf_ctrl_sense[3]}]
set_property -dict {PACKAGE_PIN F12 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {lbf_ctrl_sense[4]}]

set_property -dict {PACKAGE_PIN AM13 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports hb_lna_byp]
set_property -dict {PACKAGE_PIN AK15 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports lb_lna_byp]
set_property -dict {PACKAGE_PIN AN13 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports hb_trx_ctrl]
set_property -dict {PACKAGE_PIN AP14 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports lb_trx_ctrl]
set_property -dict {PACKAGE_PIN L20 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports gb_lb_byp_ctrl]
set_property -dict {PACKAGE_PIN G21 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports gb1_hb_byp_ctrl]
set_property -dict {PACKAGE_PIN H17 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports gb2_hb_byp_ctrl]
set_property -dict {PACKAGE_PIN H14 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports rx_test_en]
set_property -dict {PACKAGE_PIN E18 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports rx_gb_ctrl]
set_property -dict {PACKAGE_PIN E19 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {tx_gb_ctrl[0]}]
set_property -dict {PACKAGE_PIN F17 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {tx_gb_ctrl[1]}]
set_property -dict {PACKAGE_PIN K17 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {tx_gb_ctrl[2]}]
set_property -dict {PACKAGE_PIN AE15 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {led_id[0]}]
set_property -dict {PACKAGE_PIN AE14 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {led_id[1]}]
set_property -dict {PACKAGE_PIN AH13 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports bbu_gpio_0]

# Auxiliary AXI GPIO bit 0 is tx_dsa_si; bit 16 is hb_tft_sfl.
# Outputs are high-Z at reset until software configures the GPIO direction.
set_property -dict {PACKAGE_PIN C18 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports tx_dsa_si]
set_property -dict {PACKAGE_PIN A17 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports tx_dsa_clk]
set_property -dict {PACKAGE_PIN B18 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports tx_dsa_le]
set_property -dict {PACKAGE_PIN D17 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports rx_dsa_si]
set_property -dict {PACKAGE_PIN F18 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports rx_dsa_clk]
set_property -dict {PACKAGE_PIN E17 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports rx_dsa_le]
set_property -dict {PACKAGE_PIN J16 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports orx_dsa_si]
set_property -dict {PACKAGE_PIN G15 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports orx_dsa_clk]
set_property -dict {PACKAGE_PIN H16 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports orx_dsa_le]
set_property -dict {PACKAGE_PIN AH14 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports bbu_gpio_1]
set_property -dict {PACKAGE_PIN AF15 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports bbu_gpio_2]
set_property -dict {PACKAGE_PIN AG15 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports bbu_gpio_3]
set_property -dict {PACKAGE_PIN AJ14 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports trx_sclk]
set_property -dict {PACKAGE_PIN AK14 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports trx_mosi]
set_property -dict {PACKAGE_PIN AF13 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports trx_miso]
set_property -dict {PACKAGE_PIN G16 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports lb_tft_sfl]
set_property -dict {PACKAGE_PIN D20 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports hb_tft_sfl]

set_property -dict {PACKAGE_PIN L18 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {tft_ctrl_a[0]}]
set_property -dict {PACKAGE_PIN L19 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {tft_ctrl_a[1]}]
set_property -dict {PACKAGE_PIN L17 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {tft_ctrl_a[2]}]
set_property -dict {PACKAGE_PIN E22 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {tft_ctrl_a[3]}]
set_property -dict {PACKAGE_PIN A21 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {tft_ctrl_a[4]}]
set_property -dict {PACKAGE_PIN B20 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {tft_ctrl_a[5]}]
set_property -dict {PACKAGE_PIN A18 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {tft_ctrl_a[6]}]
set_property -dict {PACKAGE_PIN H21 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {tft_ctrl_a[7]}]
set_property -dict {PACKAGE_PIN H19 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {tft_ctrl_b[0]}]
set_property -dict {PACKAGE_PIN K19 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {tft_ctrl_b[1]}]
set_property -dict {PACKAGE_PIN K18 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {tft_ctrl_b[2]}]
set_property -dict {PACKAGE_PIN D22 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {tft_ctrl_b[3]}]
set_property -dict {PACKAGE_PIN B21 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {tft_ctrl_b[4]}]
set_property -dict {PACKAGE_PIN A20 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {tft_ctrl_b[5]}]
set_property -dict {PACKAGE_PIN K20 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {tft_ctrl_b[6]}]
set_property -dict {PACKAGE_PIN J19 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {tft_ctrl_b[7]}]
set_property -dict {PACKAGE_PIN H18 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {sw_ctrl_a[0]}]
set_property -dict {PACKAGE_PIN F21 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {sw_ctrl_a[1]}]
set_property -dict {PACKAGE_PIN J21 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {sw_ctrl_a[2]}]
set_property -dict {PACKAGE_PIN D19 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {sw_ctrl_a[3]}]
set_property -dict {PACKAGE_PIN J17 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {sw_ctrl_b[0]}]
set_property -dict {PACKAGE_PIN F20 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {sw_ctrl_b[1]}]
set_property -dict {PACKAGE_PIN J20 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {sw_ctrl_b[2]}]
set_property -dict {PACKAGE_PIN B19 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {sw_ctrl_b[3]}]
set_property -dict {PACKAGE_PIN G20 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports hb_tft_reset]
set_property -dict {PACKAGE_PIN H12 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports lb_tft_reset]

# T12 sheet 21, banks 47/48. CSN bit 0 maps to the schematic's CSb1 net.
set_property -dict {PACKAGE_PIN J14 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports lb_tft_sclk]
set_property -dict {PACKAGE_PIN G14 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports lb_tft_mosi]
set_property -dict {PACKAGE_PIN J15 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports lb_tft_miso]
set_property -dict {PACKAGE_PIN J12 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {lb_tft_csn[0]}]
set_property -dict {PACKAGE_PIN G13 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {lb_tft_csn[1]}]

set_property -dict {PACKAGE_PIN C21 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports hb_tft_sclk]
set_property -dict {PACKAGE_PIN D21 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports hb_tft_mosi]
set_property -dict {PACKAGE_PIN A22 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports hb_tft_miso]
set_property -dict {PACKAGE_PIN G18 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {hb_tft_csn[0]}]
set_property -dict {PACKAGE_PIN E20 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {hb_tft_csn[1]}]
set_property -dict {PACKAGE_PIN C22 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {hb_tft_csn[2]}]
set_property -dict {PACKAGE_PIN G19 IOSTANDARD LVCMOS33 PULLTYPE NONE} [get_ports {hb_tft_csn[3]}]
